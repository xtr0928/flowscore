    {
      "name": "schemaKeywordAudit",
      "schemaRef": "inline",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": [
          "schemas",
          "audit"
        ],
        "additionalProperties": false,
        "properties": {
          "schemas": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "audit": {
            "type": "object",
            "required": [
              "recursive",
              "forbiddenKeywords",
              "forbidRemoteRefs"
            ],
            "additionalProperties": false,
            "properties": {
              "recursive": {
                "const": true
              },
              "forbiddenKeywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "if",
                    "then",
                    "else",
                    "patternProperties",
                    "dependencies",
                    "unevaluatedProperties"
                  ]
                }
              },
              "forbidRemoteRefs": {
                "const": true
              }
            }
          }
        }
      },
      "doc": {
        "schemas": [
          {
            "path": "schema/pipeline.schema.json"
          },
          {
            "path": "schema/layout.schema.json"
          }
        ],
        "audit": {
          "recursive": true,
          "forbiddenKeywords": [
            "if",
            "then",
            "else",
            "patternProperties",
            "dependencies",
            "unevaluatedProperties"
          ],
          "forbidRemoteRefs": true
        }
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    }
  ]
