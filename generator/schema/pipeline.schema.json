{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pipeline.schema.json",
  "title": "管线可执行配置",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "meta",
    "runtime",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "const": "pipeline"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "x": {
      "type": "object",
      "description": "扩展袋：保存流谱格式（flowscore.pipeline）独有字段，用于无损往返"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "output_dir": {
          "type": "string",
          "minLength": 1
        },
        "concurrency": {
          "type": "integer"
        },
        "continue_on_error": {
          "type": "boolean"
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "json",
            "file",
            "any"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "builtin",
            "custom"
          ]
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputSpec": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "anyOf": [
            {
              "enum": [
                "md",
                "html",
                "json",
                "txt",
                "png"
              ]
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,10}$"
            }
          ]
        },
        "filename_template": {
          "type": "string",
          "pattern": "^[^/\\\\:*?\"<>|]+$"
        }
      }
    },
    "inputNodeConfig": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      }
    },
    "modelCallConfig": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "prompt",
        "output"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "output": {
          "$ref": "#/$defs/outputSpec"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "structured": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "结构化输出：Function Calling / JSON Schema 约束模型返回",
          "properties": {
            "mode": {
              "enum": [
                "",
                "function_call",
                "json_schema",
                null
              ]
            },
            "tool_name": {
              "type": "string"
            },
            "tool_description": {
              "type": "string"
            },
            "schema": {
              "type": [
                "object",
                "null"
              ],
              "description": "输出必须满足的 JSON Schema"
            },
            "strict": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "outputNodeConfig": {
      "type": "object",
      "properties": {
        "format": {
          "anyOf": [
            {
              "enum": [
                "md",
                "html",
                "json",
                "txt",
                "png"
              ]
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,10}$"
            }
          ]
        },
        "filename_template": {
          "type": "string",
          "pattern": "^[^/\\\\:*?\"<>|]+$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "input"
            },
            "label": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/inputNodeConfig"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "model_call"
            },
            "label": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/modelCallConfig"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "output"
            },
            "label": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/outputNodeConfig"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "note"
            },
            "label": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/noteConfig"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "task"
            },
            "label": {
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/taskConfig"
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "from_port": {
          "type": "string",
          "minLength": 1
        },
        "to_port": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "noteConfig": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "attached_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "taskConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "deterministic": {
          "type": "boolean"
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      }
    }
  }
}